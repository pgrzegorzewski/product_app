{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
    <h1>Products</h1>

    <ul>
        {% for product in products %}
            <li>
                <h2>{{ product.name }}</h2>
                <p>{{ product.description }}</p>
                <p>{{ product.size }}</p> 
                <p>
                    {{ product.isAvailable ? 'available' : 'not available' }}
                </p>
            </li>
        {% endfor %}          
    </ul>   
    

{% endblock %}
