{% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}
    <h1>Product</h1>
    
    <p>{{ product.name }}</p>
    <p>{{ product.description }}</p>
    <p>{{ product.size }}</p>
    <p>{{ product.isAvailable ? 'available' : 'not available' }}</p>
    
    <a href="{{ path('product_edit', {'id': product.id}) }}"><button>Edit Product</button></a>
    <a href="{{path('product_delete', {'id': product.id})}}"><button>Delete</button></a>
    
    <h3><a href="{{path('product_index')}}"</a>back</h3>
    
{% endblock %}
