{% extends 'base.html.twig' %}

{% block title %}Homepage{% endblock %}

{% block body %}
<h1>joł</h1>

<div class="mb-3">
{% if app.user %}      
    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>    
{% else %}
    <a href="{{ path('app_login') }}">Login</a> or 
    <a href="{{ path('app_register') }}">Register</a>
{% endif %}
</div>        

<a href="{{ path('product_index') }}">Product page</a>
<a href="{{ path('app_category_index') }}">Category page</a>

{% endblock %}
